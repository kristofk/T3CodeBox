# T3CodeBox settings. Copy to .env next to compose.yaml. Every line is optional.

# Runs the browser. Delete this line to run T3CodeBox without it.
COMPOSE_PROFILES=browser

# Image tag for both images: latest, a T3 Code version (0.0.42) or an exact build (0.0.42-1).
T3CODEBOX_TAG=latest

# User and group id for both containers. Bind-mounted folders must belong to these ids.
PUID=1000
PGID=1000

TZ=Etc/UTC

# Environment name in T3 Code clients. The hostname must be a DNS label (letters, digits, hyphens);
# T3CODEBOX_NAME takes any text and wins over it.
T3CODEBOX_HOSTNAME=t3codebox
# T3CODEBOX_NAME="Kris's NAS"

# Host ports, bound to 127.0.0.1. Put Tailscale serve or a reverse proxy in front.
T3CODE_PORT=3773
BROWSER_PORT=3774
DASHBOARD_PORT=3772

# Browser remote desktop password (user "abc"). Unset: generated on first start and printed once in
# `docker logs t3codebox-browser`; read it later with `docker exec t3codebox-browser cat /config/.t3codebox-password`.
# BROWSER_PASSWORD=

# Do not give the agents the browser tool.
# BROWSER_MCP=off

# Dashboard password. Unset: generated on first start and printed once in `docker logs t3codebox`;
# read it later with `docker exec t3codebox cat /home/t3codebox/.t3codebox/dashboard-password`.
# DASHBOARD_PASSWORD=

# No dashboard.
# DASHBOARD=off

# Turn off T3 Code's anonymous telemetry.
# T3CODE_TELEMETRY_ENABLED=false

# Sign-in without the interactive logins. Use one method per provider: Claude prefers ANTHROPIC_API_KEY
# over a subscription login and bills the API.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=
# XAI_API_KEY=
# GH_TOKEN=

# Languages whose usual version files mise follows: .nvmrc and .node-version, .python-version, .ruby-version.
# Unset: only mise.toml and .tool-versions pin versions.
# MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=node,python,ruby

# Hub mode (docs/hub.md): connect this box to a hub that manages it. The hub gives the enrolment address and a
# one-time code; T3CODEBOX_HUB_CODE_FILE reads the code from a file (a Docker secret) instead. Removing
# T3CODEBOX_HUB_URL leaves the hub on the next start.
# T3CODEBOX_HUB_URL=
# T3CODEBOX_HUB_CODE=
# T3CODEBOX_HUB_CODE_FILE=

# T3's address as other devices reach it (https://t3.example.com), for the dashboard's pairing links.
# T3CODEBOX_PUBLIC_URL=

# Behind a proxy that signs users in itself: the secret it sends in the X-T3CodeBox-Proxy-Secret header, at least 32
# characters. Only when the dashboard is reachable through that proxy alone (docs/hub.md).
# DASHBOARD_PROXY_SECRET=

# Commit author for the agents' commits (or run `git config --global` in the container).
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
