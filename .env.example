# T3CodeBox settings. Copy to .env next to compose.yaml. Every line is optional.

# Runs the browser. Delete this line to run T3CodeBox without it.
COMPOSE_PROFILES=browser

# Image tag for both images: latest, a T3 Code version (0.0.42) or an exact build (0.0.42-1).
T3CODEBOX_TAG=latest

# User and group id for both containers. Bind-mounted folders must belong to these ids.
PUID=1000
PGID=1000

TZ=Etc/UTC

# Host ports, bound to 127.0.0.1. Put Tailscale serve or a reverse proxy in front.
T3CODE_PORT=3773
BROWSER_PORT=3774

# Browser remote desktop password (user "abc"). Unset: generated on first start and printed once in
# `docker logs t3codebox-browser`; read it later with `docker exec t3codebox-browser cat /config/.t3codebox-password`.
# BROWSER_PASSWORD=

# Do not give the agents the browser tool.
# BROWSER_MCP=off

# Turn off T3 Code's anonymous telemetry.
# T3CODE_TELEMETRY_ENABLED=false

# Sign-in without the interactive logins. Use one method per provider: Claude prefers ANTHROPIC_API_KEY
# over a subscription login and bills the API.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=
# XAI_API_KEY=
# GH_TOKEN=

# Commit author for the agents' commits (or run `git config --global` in the container).
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
