#!/bin/bash
# Entrypoint of the t3codebox image: user setup, browser tool registration, the dashboard, then the command
# (`t3 serve`).
set -euo pipefail

# The uid set with compose `user:` becomes the t3codebox user (name and home) for every process,
# `docker exec` included: the image resolves users through nss_wrapper's files (see the Dockerfile).
uid=$(id -u)
gid=$(id -g)
passwd=$(grep -v '^t3codebox:' /etc/passwd; echo "t3codebox:x:$uid:$gid:T3CodeBox:$HOME:/bin/bash")
group=$(grep -v '^t3codebox:' /etc/group)
grep -q "^[^:]*:[^:]*:$gid:" <<< "$group" || group+=$'\n'"t3codebox:x:$gid:"
if ! { printf '%s\n' "$passwd" > "$NSS_WRAPPER_PASSWD" && printf '%s\n' "$group" > "$NSS_WRAPPER_GROUP"; } 2>/dev/null; then
  echo "t3codebox: warning: could not write $NSS_WRAPPER_PASSWD; uid $uid may have no user name" >&2
fi

# T3 Code names the environment after PRETTY_HOSTNAME in /etc/machine-info, else the hostname.
name=${T3CODEBOX_NAME:-}
name=${name//[$'\r\n']/}
if ! { if [ -n "$name" ]; then printf 'PRETTY_HOSTNAME="%s"\n' "$name"; fi > /etc/machine-info; } 2>/dev/null; then
  echo "t3codebox: warning: could not write /etc/machine-info; T3CODEBOX_NAME is ignored" >&2
fi

for dir in "$HOME" /workspace; do
  if [ ! -w "$dir" ]; then
    echo "t3codebox: warning: $dir is not writable by uid $(id -u); give the mounted folder to $(id -u):$(id -g)" >&2
  fi
done

# Detached so tini, not t3, reaps it.
(t3codebox-browser-setup &)

# The dashboard on port 3772, restarted whenever it exits, so it never takes T3 down. DASHBOARD=off: none.
if [ "${DASHBOARD:-on}" != off ]; then
  (while :; do
    node /usr/local/lib/t3codebox-dashboard/server.js || true
    echo "t3codebox: the dashboard stopped; restarting it in 5 s" >&2
    sleep 5
  done &)
fi

exec "$@"
