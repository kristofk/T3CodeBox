#!/bin/bash
# Playwright MCP attached to the browser container. DevTools accepts only an IP or localhost as Host,
# so the browser's IP is looked up on every start.
set -euo pipefail
host=${BROWSER_HOST:-browser}
ip=$(getent ahostsv4 "$host" | awk 'NR == 1 { print $1 }')
if [ -z "$ip" ]; then
  echo "t3codebox-browser-mcp: browser container '$host' not found; is the browser running?" >&2
  exit 1
fi
exec playwright-mcp --cdp-endpoint "http://${ip}:${BROWSER_DEVTOOLS_PORT:-9223}" "$@"
