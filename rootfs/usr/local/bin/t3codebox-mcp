#!/bin/bash
# Adds or removes a named MCP server in each agent's user config: Claude Code, Codex, Cursor, Grok Build
# and OpenCode.
#   t3codebox-mcp add <name> < spec              adds the server for every agent that has no entry of that name
#   t3codebox-mcp remove <name> <agent>… < spec  removes those agents' entries of that name, where they are still
#                                                the spec's (same command or URL); an entry changed since is kept
# The spec is JSON on stdin, so a key in a header never shows up in a process list:
#   {"command": "/usr/local/bin/…"}                                    a local server (stdio)
#   {"url": "https://…", "headers": {"Authorization": "Bearer …"}}    a remote server (streamable HTTP)
# Never changes an entry it did not write. Prints the agents it changed, one per line (claude, codex, cursor,
# grok, opencode); what it skipped goes to stderr.
set -uo pipefail

log() { echo "t3codebox: $*" >&2; }

action=${1:-}
name=${2:-}
shift 2 2>/dev/null || true
if [[ ! "$action" =~ ^(add|remove)$ ]] || [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; then
  echo "usage: t3codebox-mcp add|remove <name> [agents…] < spec.json" >&2
  exit 2
fi
spec=$(head -c 65536)

# A value that goes into a TOML or JSON string as it is: no quotes, backslashes, control characters or spaces
# in URLs and commands; header names are plain tokens.
plain='^[^"\\[:cntrl:]]+$'
command=$(jq -r '.command // empty' <<< "$spec" 2>/dev/null)
url=$(jq -r '.url // empty' <<< "$spec" 2>/dev/null)
if [ -n "$command" ] && [ -z "$url" ] && [[ "$command" =~ $plain ]] && [[ "$command" != *" "* ]]; then
  kind="command"
  match=$command
elif [ -n "$url" ] && [ -z "$command" ] && [[ "$url" =~ ^https?://[^[:space:]]+$ ]] && [[ "$url" =~ $plain ]] \
  && jq -e '(.headers // {}) | type == "object" and all(to_entries[]; (.key | test("^[A-Za-z0-9-]{1,64}$")) and (.value | type == "string" and length > 0 and length <= 1024 and (test("[\"\\\\]") | not) and (explode | all(. >= 32 and . != 127))))' <<< "$spec" >/dev/null 2>&1; then
  kind="url"
  match=$url
else
  log "t3codebox-mcp: the spec for '$name' is not usable; nothing changed"
  exit 2
fi

# One change at a time: the browser and the hub may register at the same start.
[ -d "$HOME/.t3codebox" ] || mkdir -m 700 "$HOME/.t3codebox"
exec 9> "$HOME/.t3codebox/mcp.lock"
flock -w 60 9 || { log "t3codebox-mcp: another registration is still running; nothing changed"; exit 1; }

# A remote server's entry may hold a key: only the user may read a file that has one.
if [ "$kind" = url ]; then
  umask 077
fi
private() { if [ "$kind" = url ]; then chmod go-rwx "$1"; fi; }

# A JSON config's entry for this server, by agent.
entry_json() {
  case "$1:$kind" in
    claude:url) jq -c '{type: "http", url, headers: (.headers // {})}' <<< "$spec" ;;
    cursor:command) jq -c '{command, args: []}' <<< "$spec" ;;
    cursor:url) jq -c '{url, headers: (.headers // {})}' <<< "$spec" ;;
    opencode:command) jq -c '{type: "local", command: [.command], enabled: true}' <<< "$spec" ;;
    opencode:url) jq -c '{type: "remote", url, headers: (.headers // {}), enabled: true}' <<< "$spec" ;;
  esac
}

# The command or URL of a JSON config's entry, whatever form the agent keeps it in. The spec's comes through the
# environment, like everything else that could be private.
export MCP_NAME=$name MCP_KEY=$kind MCP_MATCH=$match
json_match='(.command | if type == "array" then .[0] else . end) // .url // empty'

# replace <file> <tmp>: puts tmp in the file's place in one step, with the file's mode, so an agent reading the
# file never sees half of it. <file> is the real file, not a link to it.
replace() {
  chmod --reference="$1" "$2" 2>/dev/null
  mv -f "$2" "$1"
}

# add_json <file> <section> <agent>: add the entry if <section>.<name> is missing; skip files that are not plain JSON.
add_json() {
  local file section=$2 agent=$3 tmp
  file=$(readlink -m "$1")
  mkdir -p "$(dirname "$file")"
  [ -s "$file" ] || echo '{}' > "$file"
  if ! jq empty "$file" 2>/dev/null; then
    log "skipped $file: not plain JSON; add the $name MCP server by hand"
    return 1
  fi
  jq -e --arg s "$section" '.[$s][env.MCP_NAME] != null' "$file" >/dev/null 2>&1 && return 1
  tmp=$(mktemp "$file.XXXXXX")
  if ENTRY=$(entry_json "$agent") jq --arg s "$section" '.[$s][env.MCP_NAME] = (env.ENTRY | fromjson)' "$file" > "$tmp" 2>/dev/null; then
    replace "$file" "$tmp"
    private "$file"
  else
    rm -f "$tmp"
    log "skipped $file: its $section is not an object; add the $name MCP server by hand"
    return 1
  fi
}

# remove_json <file> <section>: remove <section>.<name> if it still has this spec's command or URL.
remove_json() {
  local file section=$2 tmp
  file=$(readlink -m "$1")
  [ -s "$file" ] && jq empty "$file" 2>/dev/null || return 1
  jq -e --arg s "$section" ".[\$s][env.MCP_NAME] | ($json_match) == env.MCP_MATCH" "$file" >/dev/null 2>&1 || return 1
  tmp=$(mktemp "$file.XXXXXX")
  if jq --arg s "$section" 'del(.[$s][env.MCP_NAME])' "$file" > "$tmp"; then
    replace "$file" "$tmp"
  else
    rm -f "$tmp"
    return 1
  fi
}

# toml <file> exists|ours: is mcp_servers.<name> in the file, in whatever form TOML allows (quoted, dotted,
# inline); ours: with this spec's command or URL. Exit 1 for no, 2 when the file is not valid TOML. Read with
# Python's tomllib, not with a pattern, so a user's table in another form is never missed.
toml() {
  python3 - "$1" "$2" <<'PY'
import os, sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        data = tomllib.load(f)
except FileNotFoundError:
    sys.exit(1)
except Exception:
    sys.exit(2)
servers = data.get("mcp_servers")
entry = servers.get(os.environ["MCP_NAME"]) if isinstance(servers, dict) else None
if sys.argv[2] == "exists":
    sys.exit(0 if entry is not None else 1)
sys.exit(0 if isinstance(entry, dict) and entry.get(os.environ["MCP_KEY"]) == os.environ["MCP_MATCH"] else 1)
PY
}

# add_toml <file> <agent>: append the server's tables if the file has no entry of that name, and keep the result
# only if it is still valid TOML with the entry in it.
add_toml() {
  local file agent=$2 tmp
  file=$(readlink -m "$1")
  toml "$file" exists
  case $? in
    0) return 1 ;;
    2) log "skipped $file: not valid TOML; add the $name MCP server by hand"; return 1 ;;
  esac
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp "$file.XXXXXX")
  [ -e "$file" ] && cat "$file" > "$tmp"
  if [ "$kind" = command ]; then
    printf '\n[mcp_servers.%s]\ncommand = "%s"\n' "$name" "$command" >> "$tmp"
  else
    toml_remote "$agent" >> "$tmp"
  fi
  if toml "$tmp" ours; then
    [ -e "$file" ] || : > "$file"
    replace "$file" "$tmp"
    private "$file"
  else
    rm -f "$tmp"
    log "skipped $file: adding the $name MCP server would not leave valid TOML; add it by hand"
    return 1
  fi
}

# The TOML tables of a remote server, in the form each agent's own `mcp add` writes.
toml_remote() {
  printf '\n[mcp_servers.%s]\nurl = "%s"\n' "$name" "$url"
  if [ "$1" = codex ]; then
    jq -r '(.headers // {}) | if length > 0 then "http_headers = { " + (to_entries | map("\"\(.key)\" = \"\(.value)\"") | join(", ")) + " }" else empty end' <<< "$spec"
  else
    echo "enabled = true"
    jq -r '(.headers // {}) | if length > 0 then "\n[mcp_servers." + env.MCP_NAME + ".headers]\n" + (to_entries | map("\(.key) = \"\(.value)\"") | join("\n")) else empty end' <<< "$spec"
  fi
}

# remove_toml <file>: remove [mcp_servers.<name>] and its subtables if they are still this spec's, in the form this
# script writes them. Comments in between are kept: they are someone else's.
remove_toml() {
  local file tmp
  file=$(readlink -m "$1")
  toml "$file" ours || return 1
  tmp=$(mktemp "$file.XXXXXX")
  MCP_TABLE="[mcp_servers.$name]" awk '
    BEGIN { table = ENVIRON["MCP_TABLE"]; prefix = substr(table, 1, length(table) - 1) "." }
    /^\[/ { skip = ($0 == table || index($0, prefix) == 1) }
    !skip || /^[ \t]*#/ { lines[++n] = $0 }
    END {
      while (n > 0 && lines[n] == "") n--
      for (i = 1; i <= n; i++) print lines[i]
    }' "$file" > "$tmp"
  # Still there (a table in another form), or no longer valid TOML: the file stays as it was.
  toml "$tmp" exists
  if [ $? = 1 ]; then
    replace "$file" "$tmp"
  else
    rm -f "$tmp"
    return 1
  fi
}

# add: every agent; remove: the agents named.
agents=" $* "
wanted() { [ "$action" = add ] || [[ "$agents" == *" $1 "* ]]; }
changed=()

# Claude Code: its own command for a local server, as it always was; the file for a remote one, whose key
# would otherwise be a command-line argument.
claude_json=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
if command -v claude >/dev/null && wanted claude; then
  if [ "$action" = add ]; then
    if ! { [ -s "$claude_json" ] && jq -e '.mcpServers[env.MCP_NAME] != null' "$claude_json" >/dev/null 2>&1; }; then
      if [ "$kind" = command ]; then
        claude mcp add --scope user "$name" -- "$command" >/dev/null 2>&1 && changed+=(claude)
      elif add_json "$claude_json" mcpServers claude; then
        changed+=(claude)
      fi
    fi
  elif remove_json "$claude_json" mcpServers; then
    changed+=(claude)
  fi
fi

# Codex
if command -v codex >/dev/null && wanted codex; then
  config="${CODEX_HOME:-$HOME/.codex}/config.toml"
  if [ "$action" = add ]; then
    add_toml "$config" codex && changed+=(codex)
  elif remove_toml "$config"; then
    changed+=(codex)
  fi
fi

# OpenCode
if command -v opencode >/dev/null && wanted opencode; then
  if [ "$action" = add ] && [ -e "$HOME/.config/opencode/opencode.jsonc" ]; then
    log "skipped OpenCode: opencode.jsonc exists; add the $name MCP server by hand"
  elif [ "$action" = add ]; then
    add_json "$HOME/.config/opencode/opencode.json" mcp opencode && changed+=(opencode)
  else
    remove_json "$HOME/.config/opencode/opencode.json" mcp && changed+=(opencode)
  fi
fi

# Grok Build: like Claude Code, its own command for a local server.
if command -v grok >/dev/null && wanted grok; then
  config="${GROK_HOME:-$HOME/.grok}/config.toml"
  if [ "$action" = add ] && [ "$kind" = command ]; then
    toml "$config" exists
    case $? in
      1) grok mcp add --scope user "$name" "$command" >/dev/null 2>&1 && changed+=(grok) ;;
      2) log "skipped $config: not valid TOML; add the $name MCP server by hand" ;;
    esac
  elif [ "$action" = add ]; then
    add_toml "$config" grok && changed+=(grok)
  elif remove_toml "$config"; then
    changed+=(grok)
  fi
fi

# Cursor
if command -v cursor-agent >/dev/null && wanted cursor; then
  if [ "$action" = add ]; then
    add_json "$HOME/.cursor/mcp.json" mcpServers cursor && changed+=(cursor)
  else
    remove_json "$HOME/.cursor/mcp.json" mcpServers && changed+=(cursor)
  fi
fi

if [ ${#changed[@]} -gt 0 ]; then
  printf '%s\n' "${changed[@]}"
fi
exit 0
