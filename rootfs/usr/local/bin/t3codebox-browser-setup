#!/bin/bash
# Adds a "browser" MCP server to each agent's user config when the browser container is running, with
# t3codebox-mcp: only where it is missing, never changing an entry the user made. BROWSER_MCP=off skips it.
set -uo pipefail

log() { echo "t3codebox: $*"; }

if [ "${BROWSER_MCP:-on}" = "off" ]; then
  exit 0
fi

host=${BROWSER_HOST:-browser}
for _ in $(seq 30); do
  getent hosts "$host" >/dev/null && break
  sleep 1
done
if ! getent hosts "$host" >/dev/null; then
  log "no browser container at '$host'; agents get no browser tool"
  exit 0
fi

mapfile -t added < <(t3codebox-mcp add browser <<< '{"command": "/usr/local/bin/t3codebox-browser-mcp"}')
if [ ${#added[@]} -gt 0 ]; then
  log "added the browser MCP server for: ${added[*]}"
fi
